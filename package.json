{
  "name": "bandcamp-collection-check",
  "version": "0.4.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crakila/bandcamp-collection-check.git"
  },
  "bugs": {
    "url": "https://github.com/Crakila/bandcamp-collection-check/issues"
  },
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "npm run lint:js && npm run lint:extension",
    "lint:js": "oxlint --deny-warnings src popup consent tests",
    "lint:extension": "web-ext lint --source-dir . --ignore-files 'tests/**' 'node_modules/**' 'package*.json' 'README.md' 'DEVELOPMENT.md' 'PRIVACY.md' '.github/**' 'artifacts/**' 'tools' 'tools/**' '.oxlintrc.json'",
    "build": "web-ext build --source-dir . --artifacts-dir artifacts --overwrite-dest --ignore-files 'tests/**' 'node_modules/**' 'package*.json' 'README.md' 'DEVELOPMENT.md' 'PRIVACY.md' '.github/**' 'artifacts/**' 'tools' 'tools/**' '.oxlintrc.json'"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "jsdom": "^26.1.0",
    "oxlint": "1.88.0",
    "web-ext": "^10.7.0"
  }
}
